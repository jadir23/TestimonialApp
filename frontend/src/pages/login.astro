---
import BaseLayout from '../layouts/BaseLayout.astro';
const error = Astro.url.searchParams.get('error');
---
<BaseLayout title="Login">
  <form method="POST" action="/api/login" class="mx-auto max-w-sm space-y-3 rounded border bg-white p-6">
    <h1 class="text-xl font-bold">Login</h1>
    {error && <p class="rounded bg-red-50 p-2 text-sm text-red-700">{error}</p>}
    <input name="email" type="email" required placeholder="Email" class="w-full rounded border px-3 py-2" />
    <input name="password" type="password" required placeholder="Password" class="w-full rounded border px-3 py-2" />
    <button class="w-full rounded bg-black py-2 text-white">Login</button>
    <p class="text-sm"><a href="/forgot-password" class="underline">Forgot password?</a> · <a href="/register" class="underline">Sign up</a></p>
  </form>
</BaseLayout>
