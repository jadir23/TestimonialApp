---
import AuthLayout from '../layouts/AuthLayout.astro';
import AuthCard from '../components/AuthCard.astro';
import Alert from '../components/Alert.astro';
import Field from '../components/Field.astro';

const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') ?? '/dashboard';
---

<AuthLayout title="Sign in">
  <AuthCard title="Welcome back" subtitle="Sign in to manage your testimonials.">
    {error && <div class="mb-5"><Alert type="danger">{error}</Alert></div>}

    <form method="POST" action="/api/login" class="card card-pad space-y-4">
      <input type="hidden" name="next" value={next} />

      <Field label="Email" name="email" required>
        <input
          id="email"
          class="input"
          type="email"
          name="email"
          required
          autocomplete="email"
          autofocus
          placeholder="you@company.com"
        />
      </Field>

      <Field label="Password" name="password" required>
        <input
          id="password"
          class="input"
          type="password"
          name="password"
          required
          autocomplete="current-password"
          placeholder="••••••••"
        />
      </Field>

      <button type="submit" class="btn btn-primary btn-lg w-full">Sign in</button>

      <p class="text-center text-sm text-fg-muted">
        <a href="/forgot-password" class="link">Forgot your password?</a>
      </p>
    </form>

    <p class="mt-6 text-center text-sm text-fg-muted">
      New here?
      <a href="/register" class="link">Create an account</a>
    </p>
  </AuthCard>
</AuthLayout>