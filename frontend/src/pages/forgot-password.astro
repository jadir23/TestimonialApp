---
import AuthLayout from '../layouts/AuthLayout.astro';
import AuthCard from '../components/AuthCard.astro';
import Alert from '../components/Alert.astro';
import Field from '../components/Field.astro';

const sent = Astro.url.searchParams.get('sent') === '1';
---

<AuthLayout title="Reset your password">
  <AuthCard
    title="Reset your password"
    subtitle="We'll email you a link to choose a new one."
  >
    {
      sent ? (
        <div class="card card-pad">
          <Alert type="success" title="Check your inbox">
            If an account exists for that address, a reset link is on its way. The
            link expires in a few hours.
          </Alert>
          <a href="/login" class="btn btn-secondary mt-5 w-full">
            Back to sign in
          </a>
        </div>
      ) : (
        <form method="POST" action="/api/request-reset" class="card card-pad space-y-4">
          <Field label="Email" name="email" required>
            <input
              id="email"
              class="input"
              type="email"
              name="email"
              required
              autocomplete="email"
              autofocus
              placeholder="you@company.com"
            />
          </Field>
          <button type="submit" class="btn btn-primary btn-lg w-full">
            Send reset link
          </button>
        </form>
      )
    }

    {
      !sent && (
        <p class="mt-6 text-center text-sm text-fg-muted">
          <a href="/login" class="link">Back to sign in</a>
        </p>
      )
    }
  </AuthCard>
</AuthLayout>