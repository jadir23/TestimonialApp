---
import BaseLayout from '../layouts/BaseLayout.astro';
const sent = Astro.url.searchParams.get('sent');
---
<BaseLayout title="Forgot password">
  <form method="POST" action="/api/request-reset" class="mx-auto max-w-sm space-y-3 rounded border bg-white p-6">
    <h1 class="text-xl font-bold">Reset password</h1>
    {sent && <p class="rounded bg-green-50 p-2 text-sm">If an account exists, a reset email was sent.</p>}
    <input name="email" type="email" required placeholder="Email" class="w-full rounded border px-3 py-2" />
    <button class="w-full rounded bg-black py-2 text-white">Send reset link</button>
  </form>
</BaseLayout>
