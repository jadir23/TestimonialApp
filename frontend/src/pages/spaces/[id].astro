---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import Stars from '../../components/Stars.astro';
import CopyButton from '../../components/CopyButton.astro';
import { sessionCookie, getUser, apiGet, publicUrl } from '../../lib/server';

const { id } = Astro.params;
const cookie = sessionCookie(Astro.request);
const user = await getUser(cookie);
if (!user) return Astro.redirect('/login');

const { ok, data } = await apiGet(`/api/spaces/${id}`, cookie);
if (!ok || !data?.space) return Astro.redirect('/spaces');
const space = data.space;
const fields: any[] = space.fields ?? [];
const shareUrl = publicUrl(`/s/${space.slug}`);
const themeLabel = String(space.theme ?? '');
---

<AppLayout title={space.name} user={user} path={Astro.url.pathname}>
  <nav class="mb-4 text-sm text-fg-muted" aria-label="Breadcrumb">
    <a href="/spaces" class="link-muted hover:text-fg">Spaces</a>
    <span class="mx-1.5 text-fg-subtle" aria-hidden="true">/</span>
    <span class="text-fg">{space.name}</span>
  </nav>

  <PageHeader title={space.name} description={space.subtitle || undefined}>
    <a
      slot="actions"
      href={`/spaces/${space.id}/settings`}
      class="btn btn-secondary btn-sm"
    >
      <Icon name="settings" class="size-4" />
      Settings
    </a>
    <a slot="actions" href={`/s/${space.slug}`} target="_blank" rel="noopener" class="btn btn-primary btn-sm">
      <Icon name="external" class="size-4" />
      Open public page
    </a>
  </PageHeader>

  <div class="grid gap-4 lg:grid-cols-[1fr_20rem] lg:items-start">
    <div class="space-y-4">
      <!-- ---------- Share link ---------- -->
      <section class="card card-pad">
        <h2 class="font-semibold">Share this link</h2>
        <p class="mt-1 text-sm text-fg-muted">
          Send this to customers. Anyone with the link can submit — no account
          needed.
        </p>
        <div class="mt-4 flex flex-col gap-2 sm:flex-row">
          <input
            id="share-link"
            class="input font-mono text-[13px]"
            readonly
            value={shareUrl}
            aria-label="Public page URL"
            onclick="this.select()"
          />
          <div class="flex gap-2">
            <CopyButton target="#share-link" label="Copy link" />
            <a href={`/s/${space.slug}`} target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
              Preview
            </a>
          </div>
        </div>
      </section>

      <!-- ---------- Submission form config ---------- -->
      <section class="card">
        <div class="card-pad border-b-line pb-4">
          <h2 class="font-semibold">Submission form</h2>
          <p class="mt-1 text-sm text-fg-muted">
            Fields customers see when they open your link.
          </p>
        </div>

        <ul class="divide-y divide-line">
          <!-- Name and email are always collected -->
          <li class="flex items-center gap-3 px-5 py-3 sm:px-6">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-surface-muted text-fg-subtle">
              <Icon name="lock" class="size-3.5" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-medium">Name</span>
              <span class="block text-xs text-fg-subtle">Always collected</span>
            </span>
            <span class="badge badge-neutral shrink-0">Required</span>
          </li>
          <li class="flex items-center gap-3 px-5 py-3 sm:px-6">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-surface-muted text-fg-subtle">
              <Icon name="lock" class="size-3.5" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-medium">Email</span>
              <span class="block text-xs text-fg-subtle">Always collected</span>
            </span>
            <span class="badge badge-neutral shrink-0">Required</span>
          </li>

          {
            fields.map((f) => (
              <li class="flex items-center gap-3 px-5 py-3 sm:px-6">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-surface-muted text-fg-subtle">
                  <Icon name="check" class="size-3.5" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-medium">{f.label}</span>
                  <span class="block font-mono text-[11px] text-fg-subtle">
                    {f.field_type}
                  </span>
                </span>
                <span
                  class:list={[
                    'badge shrink-0',
                    f.enabled ? 'badge-success' : 'badge-neutral',
                  ]}
                >
                  {f.enabled ? 'On' : 'Off'}
                  {f.enabled && f.required ? ' · Required' : ''}
                </span>
              </li>
            ))
          }
        </ul>

        <div class="flex flex-wrap items-center justify-between gap-3 border-t-line px-5 py-4 sm:px-6">
          <div class="flex items-center gap-2">
            <span class="text-sm text-fg-muted">Star ratings</span>
            {space.rating_enabled ? (
              <span class="inline-flex items-center gap-1.5">
                <Stars value={5} size="sm" />
                <span class="text-xs text-fg-subtle">enabled</span>
              </span>
            ) : (
              <span class="badge badge-neutral">Disabled</span>
            )}
          </div>
          <span class="badge badge-neutral capitalize">{themeLabel}</span>
        </div>
      </section>
    </div>

    <!-- ---------- Side rail ---------- -->
    <aside class="space-y-4">
      <section class="card card-pad">
        <h2 class="text-sm font-semibold">Quick actions</h2>
        <div class="mt-3 space-y-2">
          <a href={`/inbox?space_id=${space.id}`} class="btn btn-secondary btn-sm w-full justify-start">
            <Icon name="inbox" class="size-4" />
            View submissions
          </a>
          <a href="/embeds/new" class="btn btn-secondary btn-sm w-full justify-start">
            <Icon name="embed" class="size-4" />
            Create a widget
          </a>
          <a href={`/spaces/${space.id}/settings`} class="btn btn-ghost btn-sm w-full justify-start">
            <Icon name="settings" class="size-4" />
            Edit settings
          </a>
        </div>
      </section>
    </aside>
  </div>
</AppLayout>