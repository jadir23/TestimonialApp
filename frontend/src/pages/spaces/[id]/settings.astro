---
import AppLayout from '../../../layouts/AppLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Alert from '../../../components/Alert.astro';
import Field from '../../../components/Field.astro';
import Icon from '../../../components/Icon.astro';
import { sessionCookie, getUser, apiGet, publicGet } from '../../../lib/server';

const { id } = Astro.params;
const cookie = sessionCookie(Astro.request);
const user = await getUser(cookie);
if (!user) return Astro.redirect('/login');

const { ok, data } = await apiGet(`/api/spaces/${id}`, cookie);
if (!ok || !data?.space) return Astro.redirect('/spaces');
const space = data.space;
const fields: any[] = space.fields ?? [];

const { data: themeData } = await publicGet('/api/themes');
const themes: Record<string, any> = themeData?.themes ?? {};

const error = Astro.url.searchParams.get('error');
const okMsg = Astro.url.searchParams.get('saved');
---

<AppLayout title={`Settings — ${space.name}`} user={user} path="/spaces">
  <nav class="mb-4 text-sm text-fg-muted" aria-label="Breadcrumb">
    <a href="/spaces" class="link-muted hover:text-fg">Spaces</a>
    <span class="mx-1.5 text-fg-subtle" aria-hidden="true">/</span>
    <a href={`/spaces/${space.id}`} class="link-muted hover:text-fg">{space.name}</a>
    <span class="mx-1.5 text-fg-subtle" aria-hidden="true">/</span>
    <span class="text-fg">Settings</span>
  </nav>

  <PageHeader title="Space settings" description="Customise the page and the form your customers see.">
    <a slot="actions" href={`/spaces/${space.id}`} class="btn btn-ghost btn-sm">Cancel</a>
  </PageHeader>

  {error && <div class="mb-5"><Alert type="danger">{error}</Alert></div>}
  {okMsg && <div class="mb-5"><Alert type="success">Settings saved.</Alert></div>}

  <form method="POST" action={`/api/spaces/update?id=${space.id}`} class="card card-pad space-y-5">
    <Field label="Space name" name="name" required>
      <input id="name" class="input" name="name" value={space.name} required maxlength="120" />
    </Field>

    <Field label="Subtitle" name="subtitle" hint="Shown under the heading on the public page.">
      <textarea id="subtitle" class="input" name="subtitle" rows="2" maxlength="300">{space.subtitle}</textarea>
    </Field>

    <Field
      label="URL slug"
      name="slug"
      required
      hint="Changing this breaks links you've already shared."
    >
      <div class="flex items-center gap-2">
        <span class="shrink-0 rounded-lg bg-surface-muted px-2.5 py-2 text-sm text-fg-subtle">/s/</span>
        <input
          id="slug"
          class="input font-mono"
          name="slug"
          value={space.slug}
          required
          maxlength="40"
          pattern="[a-z0-9\-]*"
          aria-describedby="slug-hint"
        />
      </div>
    </Field>

    <Field label="Theme" name="theme" required>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" role="radiogroup" aria-label="Theme">
        {
          Object.entries(themes).map(([key, t]: [string, any]) => (
            <label class="cursor-pointer">
              <input
                type="radio"
                name="theme"
                value={key}
                class="peer sr-only"
                checked={key === space.theme}
              />
              <span class="block overflow-hidden rounded-lg border-2 border-line transition peer-checked:border-brand peer-focus-visible:ring-2 peer-focus-visible:ring-brand/40">
                <span class="flex h-14 flex-col justify-center gap-1 p-2.5" style={`background:${t.bg}`}>
                  <span class="h-1.5 w-3/4 rounded-full" style={`background:${t.accent}`} />
                  <span class="h-1 w-1/2 rounded-full opacity-40" style={`background:${t.accent}`} />
                </span>
                <span class="block border-t-line bg-surface px-2 py-1.5 text-[11px] font-medium">
                  {t.label}
                </span>
              </span>
            </label>
          ))
        }
      </div>
    </Field>

    <label class="flex cursor-pointer items-start gap-3 rounded-lg border-line p-3">
      <input type="checkbox" name="rating_enabled" value="1" checked={space.rating_enabled} class="checkbox mt-0.5" />
      <span>
        <span class="block text-sm font-medium">Enable star ratings</span>
        <span class="mt-0.5 block text-xs text-fg-muted">
          Customers can rate their experience 1–5 stars.
        </span>
      </span>
    </label>

    <div class="border-t-line pt-5">
      <h2 class="font-semibold">Optional fields</h2>
      <p class="mt-1 text-sm text-fg-muted">
        Toggle the extra details you want to collect. Name and email are always
        required.
      </p>

      <div class="mt-4 divide-y divide-line rounded-lg border-line">
        {
          fields.map((f) => (
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 px-3.5 py-3">
              <label class="flex min-w-0 flex-1 cursor-pointer items-center gap-3">
                <input
                  type="checkbox"
                  name={`field_${f.field_type}_enabled`}
                  value="1"
                  checked={f.enabled}
                  class="checkbox"
                />
                <span class="min-w-0">
                  <span class="block text-sm font-medium">{f.label}</span>
                  <span class="block font-mono text-[11px] text-fg-subtle">{f.field_type}</span>
                </span>
              </label>
              <label class="flex shrink-0 cursor-pointer items-center gap-2 text-[13px] text-fg-muted">
                <input
                  type="checkbox"
                  name={`field_${f.field_type}_required`}
                  value="1"
                  checked={f.required}
                  disabled={!f.enabled}
                  class="checkbox disabled:opacity-40"
                />
                Required
              </label>
            </div>
          ))
        }
      </div>
    </div>

    <div class="flex gap-2 border-t-line pt-5">
      <button type="submit" class="btn btn-primary">
        <Icon name="check" class="size-4" />
        Save changes
      </button>
      <a href={`/spaces/${space.id}`} class="btn btn-ghost">Cancel</a>
    </div>
  </form>

  <!-- ---------- Danger zone ---------- -->
  <section class="card card-pad mt-4 border-danger/30">
    <h2 class="font-semibold text-danger">Archive space</h2>
    <p class="mt-1 text-sm text-fg-muted">
      Stops accepting new submissions. Existing testimonials and widgets stay, but
      the public page is hidden.
    </p>
    <form
      method="POST"
      action={`/api/spaces/archive?id=${space.id}`}
      onsubmit="return confirm('Archive this space? New submissions will stop.')"
      class="mt-4"
    >
      <button type="submit" class="btn btn-danger btn-sm">
        <Icon name="trash" class="size-4" />
        Archive space
      </button>
    </form>
  </section>
</AppLayout>