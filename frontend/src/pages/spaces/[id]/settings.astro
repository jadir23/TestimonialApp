---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const { id } = Astro.params;
const cookie = Astro.request.headers.get('cookie') ?? '';
const ODOO = process.env.ODOO_URL ?? 'http://localhost:8069';
let user = null; let space: any = null; let themes: Record<string, any> = {};
try {
  const me = await fetch(`${ODOO}/api/auth/me`, { headers: { Cookie: cookie } });
  const mj = await me.json();
  if (!me.ok) return Astro.redirect('/login');
  user = mj.data.user;
  const r = await fetch(`${ODOO}/api/spaces/${id}`, { headers: { Cookie: cookie } });
  const j = await r.json();
  if (r.ok) space = j.data.space; else return Astro.redirect('/spaces');
  const t = await fetch(`${ODOO}/api/themes`); const tj = await t.json();
  if (t.ok) themes = tj.data.themes;
} catch { return Astro.redirect('/spaces'); }
const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('saved');
---
<BaseLayout title={`Settings — ${space.name}`} user={user}>
  <h1 class="text-2xl font-bold">Settings</h1>
  {error && <p class="mt-2 rounded bg-red-50 p-2 text-sm text-red-700">{error}</p>}
  {ok && <p class="mt-2 rounded bg-green-50 p-2 text-sm">Saved.</p>}
  <form method="POST" action={`/api/spaces/update?id=${space.id}`} class="mt-3 space-y-3 rounded border bg-white p-6">
    <label class="block text-sm">Name<input name="name" value={space.name} required class="mt-1 w-full rounded border px-3 py-2" /></label>
    <label class="block text-sm">Subtitle<textarea name="subtitle" class="mt-1 w-full rounded border px-3 py-2">{space.subtitle}</textarea></label>
    <label class="block text-sm">Slug<input name="slug" value={space.slug} class="mt-1 w-full rounded border px-3 py-2" /></label>
    <label class="block text-sm">Theme
      <select name="theme" class="mt-1 w-full rounded border px-3 py-2">
        {Object.entries(themes).map(([k, v]: any) => <option value={k} selected={k === space.theme}>{v.label}</option>)}
      </select>
    </label>
    <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="rating_enabled" value="1" checked={space.rating_enabled} /> Enable rating</label>
    <h2 class="font-bold">Fields (check = enabled, * = required)</h2>
    {space.fields.map((f: any) => (
      <div class="flex items-center gap-2 text-sm">
        <input type="checkbox" name={`field_${f.field_type}_enabled`} value="1" checked={f.enabled} />
        <span class="w-40">{f.label}</span>
        <label class="flex items-center gap-1 text-xs"><input type="checkbox" name={`field_${f.field_type}_required`} value="1" checked={f.required} /> required</label>
      </div>
    ))}
    <div class="flex gap-2">
      <button class="rounded bg-black px-4 py-2 text-white">Save</button>
      <a href={`/spaces/${space.id}`} class="rounded border px-4 py-2">Back</a>
    </div>
  </form>
  <form method="POST" action={`/api/spaces/archive?id=${space.id}`} onsubmit="return confirm('Archive this space?')" class="mt-3">
    <button class="text-sm text-red-600 underline">Archive space</button>
  </form>
</BaseLayout>
