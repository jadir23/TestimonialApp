---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Alert from '../../components/Alert.astro';
import EmptyState from '../../components/EmptyState.astro';
import Icon from '../../components/Icon.astro';
import { sessionCookie, getUser, apiGet, publicUrl } from '../../lib/server';

const cookie = sessionCookie(Astro.request);
const user = await getUser(cookie);
if (!user) return Astro.redirect('/login');

const { ok, data, error } = await apiGet('/api/spaces', cookie);
const spaces: any[] = data?.spaces ?? [];
const limit = data?.limit ?? user.limits?.spaces ?? 3;
const atLimit = spaces.length >= limit;
const appOrigin = publicUrl('');
---

<AppLayout title="Spaces" user={user} path={Astro.url.pathname}>
  <PageHeader
    title="Spaces"
    description="Each space is a branded page you share to collect testimonials."
  >
    <a
      slot="actions"
      href="/spaces/new"
      class:list={['btn btn-sm', atLimit ? 'btn-secondary' : 'btn-primary']}
      aria-disabled={atLimit ? 'true' : undefined}
    >
      <Icon name="plus" class="size-4" />
      New space
    </a>
  </PageHeader>

  {error && <div class="mb-5"><Alert type="danger">{error}</Alert></div>}

  {
    atLimit && (
      <div class="mb-5">
        <Alert type="warning" title="You've reached your plan limit">
          You're using {spaces.length} of {limit} spaces.{' '}
          <a href="/billing" class="font-medium underline">Upgrade to Pro</a> for 25
          spaces.
        </Alert>
      </div>
    )
  }

  {
    spaces.length === 0 && !error ? (
      <EmptyState
        icon="spaces"
        title="Create your first space"
        description="A space is a branded page with its own link. Share it and submissions arrive in your inbox for review."
      >
        <a href="/spaces/new" class="btn btn-primary btn-sm">
          <Icon name="plus" class="size-4" />
          Create a space
        </a>
      </EmptyState>
    ) : (
      <ul class="grid gap-3 sm:grid-cols-2">
        {spaces.map((s) => (
          <li class="card card-pad flex flex-col">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <a
                  href={`/spaces/${s.id}`}
                  class="font-semibold hover:underline"
                >
                  {s.name}
                </a>
                <p class="mt-0.5 truncate font-mono text-xs text-fg-subtle">
                  /s/{s.slug}
                </p>
              </div>
              <span class="badge badge-neutral shrink-0 capitalize">{s.theme}</span>
            </div>

            {s.subtitle && (
              <p class="mt-3 line-clamp-2 text-sm text-fg-muted">{s.subtitle}</p>
            )}

            <div class="mt-4 flex flex-wrap gap-2 border-t-line pt-4">
              <a href={`/spaces/${s.id}`} class="btn btn-secondary btn-sm">
                <Icon name="settings" class="size-4" />
                Settings
              </a>
              <a
                href={`/s/${s.slug}`}
                class="btn btn-ghost btn-sm"
                target="_blank"
                rel="noopener"
              >
                <Icon name="external" class="size-4" />
                Public page
              </a>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</AppLayout>