---
import BaseLayout from '../../layouts/BaseLayout.astro';
const cookie = Astro.request.headers.get('cookie') ?? '';
const ODOO = process.env.ODOO_URL ?? 'http://localhost:8069';
let user = null; let spaces: any[] = []; let error = '';
try {
  const me = await fetch(`${ODOO}/api/auth/me`, { headers: { Cookie: cookie } });
  const mj = await me.json();
  if (!me.ok) return Astro.redirect('/login');
  user = mj.data.user;
  const r = await fetch(`${ODOO}/api/spaces`, { headers: { Cookie: cookie } });
  const j = await r.json();
  if (r.ok) spaces = j.data.spaces;
  else error = j.error || 'Could not load spaces.';
} catch (e) { error = 'Backend unreachable. Is Odoo running?'; }
---
<BaseLayout title="Spaces" user={user}>
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Spaces ({spaces.length}/{user?.limits?.spaces})</h1>
    <a href="/spaces/new" class="rounded bg-black px-3 py-1.5 text-white text-sm">+ New space</a>
  </div>
  {error && <p class="mt-3 rounded bg-red-50 p-2 text-sm text-red-700">{error}</p>}
  {spaces.length === 0 && !error ? (
    <div class="mt-6 rounded border bg-white p-8 text-center">
      <p class="font-medium">No spaces yet</p>
      <p class="text-sm text-gray-600">Create your first collection space and share the link.</p>
      <a href="/spaces/new" class="mt-3 inline-block rounded bg-black px-4 py-2 text-white text-sm">Create space</a>
    </div>
  ) : (
    <div class="mt-4 grid gap-3 md:grid-cols-2">
      {spaces.map((s) => (
        <div class="rounded border bg-white p-4">
          <div class="font-bold">{s.name}</div>
          <div class="text-sm text-gray-600">/s/{s.slug} · {s.theme}</div>
          <div class="mt-2 flex gap-2 text-sm">
            <a href={`/spaces/${s.id}`} class="underline">Open</a>
            <a href={`/spaces/${s.id}/settings`} class="underline">Settings</a>
            <a href={`/s/${s.slug}`} class="underline">Public page</a>
          </div>
        </div>
      ))}
    </div>
  )}
</BaseLayout>
