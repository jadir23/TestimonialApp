---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
import { sessionCookie, getUser } from '../../lib/server';

const cookie = sessionCookie(Astro.request);
const user = await getUser(cookie);
---

<AppLayout title="Payment successful" user={user}>
  <div class="mx-auto max-w-md py-10 text-center">
    <span
      class="mx-auto flex size-14 items-center justify-center rounded-full bg-success-soft text-success"
      aria-hidden="true"
    >
      <Icon name="check" class="size-7" />
    </span>
    <h1 class="mt-5 text-2xl font-semibold tracking-tight">Payment successful</h1>
    <p class="mt-2 text-sm text-fg-muted">
      Your Pro subscription activates as soon as Stripe confirms the payment —
      usually within seconds.
    </p>
    <div class="mt-6 rounded-lg bg-surface-muted p-3 text-left text-xs text-fg-muted">
      For security, this redirect alone never upgrades your plan. Only a verified
      Stripe webhook does.
    </div>
    <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:justify-center">
      <a href="/billing?notice=success" class="btn btn-primary">Check billing status</a>
      <a href="/dashboard" class="btn btn-ghost">Back to dashboard</a>
    </div>
  </div>
</AppLayout>