---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
import { sessionCookie, getUser } from '../../lib/server';

const cookie = sessionCookie(Astro.request);
const user = await getUser(cookie);
---

<AppLayout title="Checkout cancelled" user={user}>
  <div class="mx-auto max-w-md py-10 text-center">
    <span
      class="mx-auto flex size-14 items-center justify-center rounded-full bg-surface-muted text-fg-muted"
      aria-hidden="true"
    >
      <Icon name="x" class="size-7" />
    </span>
    <h1 class="mt-5 text-2xl font-semibold tracking-tight">Checkout cancelled</h1>
    <p class="mt-2 text-sm text-fg-muted">
      No charge was made. You can upgrade whenever you're ready.
    </p>
    <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:justify-center">
      <a href="/billing?notice=cancelled" class="btn btn-primary">Back to billing</a>
      <a href="/dashboard" class="btn btn-ghost">Back to dashboard</a>
    </div>
  </div>
</AppLayout>