---
import BaseLayout from '../../layouts/BaseLayout.astro';
const cookie = Astro.request.headers.get('cookie') ?? '';
const ODOO = process.env.ODOO_URL ?? 'http://localhost:8069';
let user = null;
try {
  const me = await fetch(`${ODOO}/api/auth/me`, { headers: { Cookie: cookie } });
  const mj = await me.json();
  if (me.ok) user = mj.data.user;
} catch {}
---
<BaseLayout title="Checkout cancelled" user={user}>
  <div class="mx-auto max-w-md rounded border bg-white p-8 text-center">
    <h1 class="mt-2 text-2xl font-bold">Checkout cancelled</h1>
    <p class="mt-1 text-sm text-gray-600">No charge was made.</p>
    <a href="/billing?notice=cancelled" class="mt-3 inline-block rounded bg-black px-4 py-2 text-white text-sm">Back to billing</a>
  </div>
</BaseLayout>
