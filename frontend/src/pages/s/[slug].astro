---
import '../../styles/global.css';

const { slug } = Astro.params;
const ODOO = process.env.ODOO_URL ?? 'http://localhost:8069';

let space: any = null;
try {
  const r = await fetch(`${ODOO}/api/public/s/${slug}`);
  const j = await r.json();
  if (r.ok) space = j.data.space;
} catch {}
if (!space) return new Response('Space not found', { status: 404 });

const cfg = space.theme_config ?? {};
const fields: any[] = space.fields ?? [];
const enabled = fields.filter((f: any) => f.enabled);
const error = Astro.url.searchParams.get('error');

// Field type -> input type, so URLs get url inputs and emails get email inputs.
const INPUT_TYPE: Record<string, string> = {
  website: 'url',
  linkedin: 'url',
  twitter: 'text',
  profile_photo: 'url',
};
const inputType = (t: string) => INPUT_TYPE[t] ?? 'text';

/**
 * Pick readable text for a background. Several themes (Bold, Dark Mono) use a
 * dark card, so text cannot simply inherit the page background colour — that
 * would render dark-on-dark. Uses WCAG relative luminance.
 */
function isDark(hex: string): boolean {
  const s = String(hex ?? '').replace('#', '');
  const full = s.length === 3 ? s.split('').map((c) => c + c).join('') : s;
  if (full.length !== 6) return false;
  const [r, g, b] = [0, 2, 4].map((i) => {
    const c = parseInt(full.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b < 0.35;
}

const bg = cfg.bg ?? '#ffffff';
const card = cfg.card ?? '#ffffff';
const accent = cfg.accent ?? '#111827';
const darkCard = isDark(card);
const darkPage = isDark(bg);
// Text on the card, and text on the page background (used for the heading).
const onCard = darkCard ? '#f8fafc' : '#111827';
const onPage = darkPage ? '#f8fafc' : '#111827';
// Button label: contrast against the accent itself, not the card.
const onAccent = isDark(accent) ? '#ffffff' : '#111827';
const inputBg = darkCard ? 'rgba(255,255,255,.06)' : 'rgba(255,255,255,.7)';
const inputBorder = darkCard ? 'rgba(248,250,252,.22)' : 'rgba(17,24,39,.2)';

// The theme drives a few CSS variables so components can follow the accent.
const themeVars = [
  `--ts-bg:${bg}`,
  `--ts-card:${card}`,
  `--ts-accent:${accent}`,
  `--ts-on-card:${onCard}`,
  `--ts-on-accent:${onAccent}`,
  `--ts-input-bg:${inputBg}`,
  `--ts-input-border:${inputBorder}`,
  `--ts-font:${cfg.font ?? 'Inter, system-ui'}`,
].join(';');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{space.name}</title>
    <meta name="description" content={space.subtitle || `Share your experience with ${space.name}.`} />
    <meta name="robots" content="noindex" />
    <script is:inline src="/theme.js"></script>
    <style is:inline set:html={themeVars}></style>
  </head>
  <body class="min-h-screen" style={`background:${bg};color:${onPage};font-family:var(--ts-font)`}>
    <main class="mx-auto w-full max-w-lg px-4 py-10 sm:py-16">
      <!-- ---------- Header ---------- -->
      <header class="text-center">
        <h1 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl" style={`color:${accent}`}>
          {space.name}
        </h1>
        {
          space.subtitle && (
            <p class="mx-auto mt-2.5 max-w-sm text-pretty" style={`color:${onPage};opacity:.72`}>{space.subtitle}</p>
          )
        }
      </header>

      <!-- ---------- Form ---------- -->
      <div
        class="mt-8 rounded-2xl p-6 shadow-lg sm:p-8"
        style={`background:${card};color:${onCard}`}
      >
        <form method="POST" action={`/api/public/submit?slug=${space.slug}`} class="space-y-4">
          {
            error && (
              <div
                class="rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-700 dark:text-red-300"
                role="alert"
              >
                {error}
              </div>
            )
          }

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-[13px] font-medium">
                Your name <span class="text-red-500">*</span>
              </span>
              <input
                name="name"
                required
                autocomplete="name"
                placeholder="Jane Doe"
                class="ts-input"
              />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-[13px] font-medium">
                Email <span class="text-red-500">*</span>
              </span>
              <input
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="jane@company.com"
                class="ts-input"
              />
            </label>
          </div>

          {
            enabled.length > 0 && (
              <div class="grid gap-4 sm:grid-cols-2">
                {enabled.map((f: any) => (
                  <label class="block">
                    <span class="mb-1.5 block text-[13px] font-medium">
                      {f.label}
                      {f.required && <span class="text-red-500"> *</span>}
                    </span>
                    <input
                      name={f.field_type}
                      type={inputType(f.field_type)}
                      required={f.required}
                      autocomplete="off"
                      placeholder={f.label}
                      class="ts-input"
                    />
                  </label>
                ))}
              </div>
            )
          }

          {
            space.rating_enabled && (
              <fieldset>
                <legend class="mb-1.5 text-[13px] font-medium">Your rating</legend>
                <div class="flex items-center gap-1" data-stars>
                  {
                    [1, 2, 3, 4, 5].map((n) => (
                      <label class="cursor-pointer">
                        <input
                          type="radio"
                          name="rating"
                          value={n}
                          class="peer sr-only"
                          data-star={n}
                        />
                        <svg
                          class="size-7 transition peer-focus-visible:ring-2 peer-focus-visible:ring-current"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.9-5.4 2.9 1-6L3.2 9.4l6.1-.9L12 3Z" />
                        </svg>
                        <span class="sr-only">{n} star{n > 1 ? 's' : ''}</span>
                      </label>
                    ))
                  }
                </div>
              </fieldset>
            )
          }

          <label class="block">
            <span class="mb-1.5 block text-[13px] font-medium">
              Your testimonial <span class="text-red-500">*</span>
            </span>
            <textarea
              name="content"
              required
              maxlength="2000"
              rows="5"
              placeholder="Tell us about your experience…"
              class="ts-input resize-y"
              data-counter-wrap
            ></textarea>
            <span class="mt-1 block text-right text-[11px] text-fg-subtle" data-counter>
              0 / 2000
            </span>
          </label>

          <label class="flex cursor-pointer items-start gap-2.5 text-[13px] leading-relaxed">
            <input type="checkbox" name="consent" value="1" required class="ts-check mt-0.5" />
            <span class="text-fg-muted">
              I give permission for this testimonial to be displayed publicly and shared
              on social media.
            </span>
          </label>

          {/* Honeypot — hidden from people, tempting to bots. */}
          <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
            <label>
              Website
              <input type="text" name="website_url" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <button
            type="submit"
            class="w-full rounded-lg px-4 py-2.5 text-sm font-semibold text-white transition hover:brightness-110"
            style={`background:${accent};color:${onAccent}`}
          >
            Submit testimonial
          </button>

          <p class="text-center text-[11px] text-fg-subtle">
            Reviewed before publishing — typically within a day.
          </p>
        </form>
      </div>
    </main>

    <style is:inline>
      /* Inputs inherit the space theme rather than the app's tokens. */
      .ts-input {
        width: 100%;
        border-radius: 0.5rem;
        border: 1px solid var(--ts-input-border);
        background: var(--ts-input-bg);
        padding: 0.55rem 0.75rem;
        font-size: 0.875rem;
        color: inherit;
      }
      .ts-input::placeholder {
        color: color-mix(in oklab, currentColor 45%, transparent);
      }
      .ts-input:focus {
        outline: 2px solid var(--ts-accent);
        outline-offset: 1px;
        border-color: transparent;
      }
      .ts-check {
        width: 1rem;
        height: 1rem;
        margin-top: 0.1rem;
        accent-color: var(--ts-accent);
      }
      /* Star track: inactive by default, filled up to the checked value. */
      [data-stars] svg {
        color: color-mix(in oklab, currentColor 24%, transparent);
      }
      [data-stars]:has(input[value='1']:checked) label:nth-child(-n + 1) svg,
      [data-stars]:has(input[value='2']:checked) label:nth-child(-n + 2) svg,
      [data-stars]:has(input[value='3']:checked) label:nth-child(-n + 3) svg,
      [data-stars]:has(input[value='4']:checked) label:nth-child(-n + 4) svg,
      [data-stars]:has(input[value='5']:checked) label:nth-child(-n + 5) svg,
      [data-stars] label:hover svg,
      [data-stars] label:hover ~ label svg {
        color: #f59e0b;
      }
    </style>

    <script is:inline>
      // Star highlighting is pure CSS; only the counter needs JS.
      (function () {
        var ta = document.querySelector('[data-counter-wrap]');
        var out = document.querySelector('[data-counter]');
        if (!ta || !out) return;
        var max = Number(ta.getAttribute('maxlength')) || 2000;
        function update() {
          out.textContent = ta.value.length + ' / ' + max;
        }
        ta.addEventListener('input', update);
        update();
      })();
    </script>
  </body>
</html>