---
const { slug } = Astro.params;
import '../../../styles/global.css';
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>Thank you</title></head>
<body class="min-h-screen bg-gray-50">
  <main class="mx-auto max-w-md px-4 py-16 text-center">
    <div class="rounded-xl bg-white p-8 shadow">
      <div class="text-4xl">🎉</div>
      <h1 class="mt-2 text-2xl font-bold">Thank you!</h1>
      <p class="mt-1 text-gray-600">Your testimonial has been received. You just made someone's day!</p>
      <a href={`/s/${slug}`} class="mt-4 inline-block text-sm underline">Back to {slug}</a>
    </div>
  </main>
</body>
</html>
