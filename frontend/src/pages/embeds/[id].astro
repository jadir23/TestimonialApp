---
import BaseLayout from '../../layouts/BaseLayout.astro';
const { id } = Astro.params;
const cookie = Astro.request.headers.get('cookie') ?? '';
const ODOO = process.env.ODOO_URL ?? 'http://localhost:8069';
const APP = process.env.PUBLIC_APP_URL ?? Astro.url.origin;
let user = null; let embed: any = null;
try {
  const me = await fetch(`${ODOO}/api/auth/me`, { headers: { Cookie: cookie } });
  const mj = await me.json();
  if (!me.ok) return Astro.redirect('/login');
  user = mj.data.user;
  const r = await fetch(`${ODOO}/api/embeds/${id}`, { headers: { Cookie: cookie } });
  const j = await r.json();
  if (r.ok) embed = j.data.embed; else return Astro.redirect('/embeds');
} catch { return Astro.redirect('/embeds'); }
const saved = Astro.url.searchParams.get('saved');
const snippet = embed.snippet.replace('async"></script>', `async"></script>`).replace('/embed.js', `${APP}/embed.js`);
const previewJson = JSON.stringify({ embed, testimonials: embed.preview ?? [] });
---
<BaseLayout title={`Embed — ${embed.name}`} user={user}>
  <h1 class="text-2xl font-bold">{embed.name} <span class="text-sm font-normal text-gray-500">· {embed.space_name}</span></h1>
  {saved && <p class="mt-2 rounded bg-green-50 p-2 text-sm">Saved.</p>}
  <div class="mt-3 grid gap-4 md:grid-cols-2">
    <form method="POST" action={`/api/embeds/update?id=${embed.id}`} id="cfg" class="space-y-2 rounded border bg-white p-4 text-sm">
      <label class="block">Name<input name="name" value={embed.name} class="mt-1 w-full rounded border px-2 py-1" /></label>
      <div class="grid grid-cols-2 gap-2">
        <label>Layout<select name="layout" class="mt-1 w-full rounded border px-2 py-1">
          <option value="grid" selected={embed.layout === 'grid'}>Grid/Masonry</option>
          <option value="carousel" selected={embed.layout === 'carousel'}>Carousel</option></select></label>
        <label>Appearance<select name="appearance" class="mt-1 w-full rounded border px-2 py-1">
          {['light','dark','auto'].map((a) => <option value={a} selected={embed.appearance === a}>{a}</option>)}</select></label>
        <label>Animation<select name="animation" class="mt-1 w-full rounded border px-2 py-1">
          {['none','fade','slide'].map((a) => <option value={a} selected={embed.animation === a}>{a}</option>)}</select></label>
        <label>Background<select name="background" class="mt-1 w-full rounded border px-2 py-1">
          <option value="transparent" selected={embed.background === 'transparent'}>Transparent</option>
          <option value="custom" selected={embed.background === 'custom'}>Custom color</option></select></label>
        <label>Count<select name="testimonial_limit" class="mt-1 w-full rounded border px-2 py-1">
          {[3,6,9,0].map((n) => <option value={n} selected={embed.testimonial_limit === n}>{n === 0 ? 'All' : n}</option>)}</select></label>
        <label>BG color<input type="color" name="bg_color" value={embed.bg_color} class="mt-1 h-8 w-full rounded border" /></label>
      </div>
      <div class="flex gap-2"><button class="rounded bg-black px-4 py-1.5 text-white">Save</button><a href="/embeds" class="rounded border px-4 py-1.5">Back</a></div>
    </form>
    <div class="rounded border bg-gray-50 p-2">
      <p class="px-2 py-1 text-xs uppercase tracking-wide text-gray-500">Live preview ({(embed.preview ?? []).length} published)</p>
      <div id="preview"></div>
    </div>
  </div>
  <div class="mt-4 rounded border bg-white p-4">
    <h2 class="font-bold text-sm">Embed code</h2>
    <pre class="mt-1 overflow-x-auto rounded bg-gray-900 p-3 text-xs text-green-200">{snippet}</pre>
    <button id="copy" class="mt-2 rounded border px-3 py-1 text-sm">Copy snippet</button>
    <form method="POST" action={`/api/embeds/delete?id=${embed.id}`} onsubmit="return confirm('Delete widget?')" class="mt-2"><button class="text-sm text-red-600 underline">Delete widget</button></form>
  </div>
  <script src="/embed.js" is:inline></script>
  <script define:vars={{ previewJson }}>
    const data = JSON.parse(previewJson);
    const form = document.getElementById('cfg');
    const prev = document.getElementById('preview');
    function current() {
      const fd = new FormData(form);
      const limit = Number(fd.get('testimonial_limit'));
      const all = data.testimonials;
      return { embed: {
        layout: fd.get('layout'), appearance: fd.get('appearance'),
        animation: fd.get('animation'), background: fd.get('background'),
        bg_color: fd.get('bg_color'),
      }, testimonials: limit === 0 ? all.slice(0, 50) : all.slice(0, limit) };
    }
    function draw() { window.TSWidget.render(prev, current()); }
    form.addEventListener('input', draw); draw();
    document.getElementById('copy').addEventListener('click', async (e) => {
      const txt = e.target.closest('div').querySelector('pre').innerText;
      await navigator.clipboard.writeText(txt); e.target.innerText = 'Copied!';
    });
  </script>
</BaseLayout>
