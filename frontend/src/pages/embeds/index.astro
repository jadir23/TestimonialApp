---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Alert from '../../components/Alert.astro';
import EmptyState from '../../components/EmptyState.astro';
import Icon from '../../components/Icon.astro';
import { sessionCookie, getUser, apiGet } from '../../lib/server';

const cookie = sessionCookie(Astro.request);
const user = await getUser(cookie);
if (!user) return Astro.redirect('/login');

const { data, error } = await apiGet('/api/embeds', cookie);
const embeds: any[] = data?.embeds ?? [];

const LIMIT_LABEL: Record<string, string> = { '3': '3 items', '6': '6 items', '9': '9 items', '0': 'All' };
---

<AppLayout title="Embeds" user={user} path={Astro.url.pathname}>
  <PageHeader
    title="Embeds"
    description="Widgets you can paste into any website to show your published testimonials."
  >
    <a slot="actions" href="/embeds/new" class="btn btn-primary btn-sm">
      <Icon name="plus" class="size-4" />
      New embed
    </a>
  </PageHeader>

  {error && <div class="mb-5"><Alert type="danger">{error}</Alert></div>}

  {
    embeds.length === 0 && !error ? (
      <EmptyState
        icon="embed"
        title="No widgets yet"
        description="Publish a few testimonials, then create a widget to display them on your site."
      >
        <a href="/embeds/new" class="btn btn-primary btn-sm">
          <Icon name="plus" class="size-4" />
          Create your first widget
        </a>
      </EmptyState>
    ) : (
      <ul class="grid gap-3 sm:grid-cols-2">
        {embeds.map((e) => (
          <li class="card card-pad flex flex-col">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <a href={`/embeds/${e.id}`} class="font-semibold hover:underline">
                  {e.name}
                </a>
                <p class="mt-0.5 truncate text-[13px] text-fg-muted">{e.space_name}</p>
              </div>
              <span class="badge badge-neutral shrink-0 capitalize">{e.layout}</span>
            </div>

            <dl class="mt-4 flex flex-wrap gap-1.5">
              <span class="badge badge-neutral">{e.appearance}</span>
              {e.animation !== 'none' && (
                <span class="badge badge-neutral capitalize">{e.animation}</span>
              )}
              <span class="badge badge-neutral">
                {LIMIT_LABEL[String(e.testimonial_limit)] ?? e.testimonial_limit}
              </span>
            </dl>

            <div class="mt-4 flex items-center gap-2 border-t-line pt-4">
              <a href={`/embeds/${e.id}`} class="btn btn-secondary btn-sm">
                <Icon name="settings" class="size-4" />
                Open builder
              </a>
              <a href={`/embeds/${e.id}#snippet`} class="btn btn-ghost btn-sm">
                <Icon name="copy" class="size-4" />
                Get code
              </a>
            </div>
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-6">
    <Alert type="info" title="Only published testimonials appear">
      Widgets read from your public embed endpoint, so pending and hidden
      testimonials are never exposed — even if someone has the URL.
    </Alert>
  </div>
</AppLayout>