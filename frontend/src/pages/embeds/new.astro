---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Alert from '../../components/Alert.astro';
import Field from '../../components/Field.astro';
import Icon from '../../components/Icon.astro';
import { sessionCookie, getUser, apiGet } from '../../lib/server';

const cookie = sessionCookie(Astro.request);
const user = await getUser(cookie);
if (!user) return Astro.redirect('/login');

const { data } = await apiGet('/api/spaces', cookie);
const spaces: any[] = data?.spaces ?? [];
const error = Astro.url.searchParams.get('error');
---

<AppLayout title="New embed" user={user} path="/embeds">
  <PageHeader title="New embed" description="Pick a space and a look — you can change everything later.">
    <a slot="actions" href="/embeds" class="btn btn-ghost btn-sm">Cancel</a>
  </PageHeader>

  {error && <div class="mb-5"><Alert type="danger">{error}</Alert></div>}

  {
    spaces.length === 0 ? (
      <Alert type="warning" title="You need a space first">
        Widgets pull testimonials from a space.{' '}
        <a href="/spaces/new" class="font-medium underline">Create a space</a> to get
        started.
      </Alert>
    ) : (
      <form method="POST" action="/api/embeds/create" class="card card-pad space-y-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <Field label="Widget name" name="name" required>
            <input
              id="name"
              class="input"
              name="name"
              required
              autofocus
              maxlength="80"
              placeholder="Homepage wall"
            />
          </Field>

          <Field label="Space" name="space_id" required>
            <select id="space_id" class="input" name="space_id" required>
              {spaces.map((s) => (
                <option value={s.id}>{s.name}</option>
              ))}
            </select>
          </Field>
        </div>

        <fieldset class="border-t-line pt-5">
          <legend class="text-sm font-semibold">Appearance</legend>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <Field label="Layout" name="layout">
              <select id="layout" class="input" name="layout" data-preview-input>
                <option value="grid">Grid / masonry</option>
                <option value="carousel">Carousel</option>
              </select>
            </Field>

            <Field label="Theme" name="appearance">
              <select id="appearance" class="input" name="appearance" data-preview-input>
                <option value="light">Light</option>
                <option value="dark">Dark</option>
                <option value="auto">Match site</option>
              </select>
            </Field>

            <Field label="Animation" name="animation">
              <select id="animation" class="input" name="animation" data-preview-input>
                <option value="none">None</option>
                <option value="fade">Fade in</option>
                <option value="slide">Slide in</option>
              </select>
            </Field>

            <Field label="How many" name="testimonial_limit" hint="Maximum testimonials shown.">
              <select id="testimonial_limit" class="input" name="testimonial_limit" data-preview-input>
                <option value="3">3</option>
                <option value="6" selected>6</option>
                <option value="9">9</option>
                <option value="0">All published</option>
              </select>
            </Field>
          </div>
        </fieldset>

        <fieldset class="border-t-line pt-5">
          <legend class="text-sm font-semibold">Background</legend>
          <div class="mt-4 flex flex-wrap items-end gap-5">
            <Field label="Style" name="background">
              <select id="background" class="input" name="background" data-preview-input>
                <option value="transparent">Transparent</option>
                <option value="custom">Custom colour</option>
              </select>
            </Field>
            <Field label="Colour" name="bg_color">
              <div class="flex items-center gap-2">
                <input
                  type="color"
                  id="bg_color"
                  name="bg_color"
                  value="#ffffff"
                  class="h-9 w-14 cursor-pointer rounded-lg border-line-strong bg-surface p-1"
                  data-preview-input
                />
                <span class="text-xs text-fg-subtle">Used on light pages</span>
              </div>
            </Field>
          </div>
        </fieldset>

        <div class="flex gap-2 border-t-line pt-5">
          <button type="submit" class="btn btn-primary">
            <Icon name="plus" class="size-4" />
            Create &amp; open builder
          </button>
          <a href="/embeds" class="btn btn-ghost">Cancel</a>
        </div>
      </form>
    )
  }
</AppLayout>