---
import BaseLayout from '../layouts/BaseLayout.astro';
const error = Astro.url.searchParams.get('error');
---
<BaseLayout title="Sign up">
  <form method="POST" action="/api/register" class="mx-auto max-w-sm space-y-3 rounded border bg-white p-6">
    <h1 class="text-xl font-bold">Create account</h1>
    {error && <p class="rounded bg-red-50 p-2 text-sm text-red-700">{error}</p>}
    <input name="name" required placeholder="Name" class="w-full rounded border px-3 py-2" />
    <input name="email" type="email" required placeholder="Email" class="w-full rounded border px-3 py-2" />
    <input name="password" type="password" required minlength="8" placeholder="Password (8+ chars)" class="w-full rounded border px-3 py-2" />
    <button class="w-full rounded bg-black py-2 text-white">Sign up</button>
    <p class="text-sm"><a href="/login" class="underline">Have an account?</a></p>
  </form>
</BaseLayout>
