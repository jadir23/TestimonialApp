---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Testimonial SaaS — collect testimonials">
  <div class="py-16 text-center">
    <h1 class="text-4xl font-bold">Collect testimonials in minutes</h1>
    <p class="mt-3 text-gray-600">Create a space, share a link, publish to your site.</p>
    <div class="mt-6 flex justify-center gap-3">
      <a href="/register" class="rounded bg-black px-4 py-2 text-white">Get started free</a>
      <a href="/login" class="rounded border px-4 py-2">Login</a>
    </div>
  </div>
</BaseLayout>
