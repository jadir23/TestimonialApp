---
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Alert from '../components/Alert.astro';
import EmptyState from '../components/EmptyState.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Stars from '../components/Stars.astro';
import Icon from '../components/Icon.astro';
import { sessionCookie, getUser, apiGet, timeAgo } from '../lib/server';

const cookie = sessionCookie(Astro.request);
const user = await getUser(cookie);
if (!user) return Astro.redirect('/login');

const status = Astro.url.searchParams.get('status') || 'all';
const spaceId = Astro.url.searchParams.get('space_id') || '';

const q = new URLSearchParams();
if (status !== 'all') q.set('status', status);
if (spaceId) q.set('space_id', spaceId);

const { ok, data, error } = await apiGet('/api/testimonials', cookie, q);
const testimonials: any[] = data?.testimonials ?? [];
const spaces: any[] = data?.spaces ?? [];

const TABS = [
  { key: 'all', label: 'All' },
  { key: 'pending', label: 'Pending' },
  { key: 'published', label: 'Published' },
  { key: 'hidden', label: 'Hidden' },
  { key: 'favorites', label: 'Favorites' },
];

function tabHref(key: string) {
  const p = new URLSearchParams();
  if (key !== 'all') p.set('status', key);
  if (spaceId) p.set('space_id', spaceId);
  const s = p.toString();
  return s ? `/inbox?${s}` : '/inbox';
}

// Preserve the current view when acting on a card.
const back = encodeURIComponent(Astro.url.pathname + Astro.url.search);
const initials = (name: string) =>
  (name ?? '?')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w: string) => w[0]!.toUpperCase())
    .join('');
---

<AppLayout title="Inbox" user={user} path={Astro.url.pathname}>
  <PageHeader
    title="Inbox"
    description="Review and publish what your customers send you."
  />

  {error && <div class="mb-5"><Alert type="danger">{error}</Alert></div>}

  <!-- ---------- Filters ---------- -->
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <div
      class="flex flex-wrap items-center gap-1 rounded-lg bg-surface-muted p-1"
      role="tablist"
      aria-label="Filter by status"
    >
      {
        TABS.map((t) => (
          <a
            href={tabHref(t.key)}
            role="tab"
            aria-selected={status === t.key ? 'true' : 'false'}
            class:list={[
              'rounded-md px-3 py-1.5 text-[13px] font-medium transition',
              status === t.key
                ? 'bg-surface text-fg shadow-card'
                : 'text-fg-muted hover:text-fg',
            ]}
          >
            {t.label}
          </a>
        ))
      }
    </div>

    <form method="GET" action="/inbox" class="flex items-center gap-2">
      <input type="hidden" name="status" value={status} />
      <label class="sr-only" for="space_id">Filter by space</label>
      <div class="relative">
        <Icon
          name="filter"
          class="pointer-events-none absolute top-1/2 left-2.5 size-4 -translate-y-1/2 text-fg-subtle"
        />
        <select
          id="space_id"
          name="space_id"
          class="input h-9 w-auto py-1 pl-8 text-[13px]"
        >
          <option value="">All spaces</option>
          {
            spaces.map((s) => (
              <option value={s.id} selected={String(s.id) === spaceId}>
                {s.name}
              </option>
            ))
          }
        </select>
      </div>
      <noscript>
        <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
      </noscript>
    </form>
  </div>

  <!-- ---------- List ---------- -->
  {
    testimonials.length === 0 && !error ? (
      <EmptyState
        icon="inbox"
        title={status === 'all' ? 'No testimonials yet' : 'Nothing here'}
        description={
          status === 'all'
            ? 'Share a space link and submissions will land right here for review.'
            : 'No testimonials match this filter. Try another tab.'
        }
      >
        {status === 'all' ? (
          <a href="/spaces" class="btn btn-primary btn-sm">
            <Icon name="globe" class="size-4" />
            Go to spaces
          </a>
        ) : (
          <a href="/inbox" class="btn btn-secondary btn-sm">Clear filter</a>
        )}
      </EmptyState>
    ) : (
      <ul class="space-y-3">
        {testimonials.map((t) => (
          <li class="card card-pad">
            <div class="flex items-start justify-between gap-3">
              <div class="flex min-w-0 items-start gap-3">
                {t.profile_photo ? (
                  <img
                    src={t.profile_photo}
                    alt=""
                    class="size-10 shrink-0 rounded-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <span
                    class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-soft text-[13px] font-semibold text-brand"
                    aria-hidden="true"
                  >
                    {initials(t.name)}
                  </span>
                )}

                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span class="truncate font-medium">{t.name}</span>
                    {(t.company_name || t.job_title) && (
                      <span class="truncate text-[13px] text-fg-muted">
                        {[t.job_title, t.company_name].filter(Boolean).join(' · ')}
                      </span>
                    )}
                  </div>
                  <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-fg-subtle">
                    <StatusBadge status={t.status} />
                    {t.space_name && <span>{t.space_name}</span>}
                    <span aria-hidden="true">·</span>
                    <time datetime={t.submitted_at}>{timeAgo(t.submitted_at)}</time>
                    {t.rating ? <Stars value={t.rating} size="sm" /> : null}
                  </div>
                </div>
              </div>

              {/* Favorite */}
              <form method="POST" action={`/api/testimonials/favorite?id=${t.id}&back=${back}`}>
                <button
                  type="submit"
                  class:list={[
                    'btn btn-ghost btn-icon',
                    t.is_favorite ? 'text-danger' : 'opacity-40 hover:opacity-100',
                  ]}
                  aria-pressed={t.is_favorite ? 'true' : 'false'}
                  aria-label={t.is_favorite ? `Remove ${t.name} from favorites` : `Add ${t.name} to favorites`}
                  title={t.is_favorite ? 'Remove favorite' : 'Add to favorites'}
                >
                  <Icon name="heart" class="size-4" />
                </button>
              </form>
            </div>

            <blockquote class="mt-3.5 border-l-2 border-line pl-3.5 text-sm leading-relaxed text-fg">
              {t.content}
            </blockquote>

            <div class="mt-4 flex flex-wrap items-center gap-2">
              {t.status !== 'published' ? (
                <form method="POST" action={`/api/testimonials/publish?id=${t.id}&back=${back}`}>
                  <button type="submit" class="btn btn-primary btn-sm">
                    <Icon name="check" class="size-4" />
                    Publish
                  </button>
                </form>
              ) : (
                <form method="POST" action={`/api/testimonials/hide?id=${t.id}&back=${back}`}>
                  <button type="submit" class="btn btn-secondary btn-sm">
                    <Icon name="eyeOff" class="size-4" />
                    Hide
                  </button>
                </form>
              )}

              <details class="relative ml-auto">
                <summary
                  class="btn btn-ghost btn-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden"
                  aria-label="More actions"
                >
                  <Icon name="more" class="size-4" />
                  More
                </summary>
                <div
                  class="absolute right-0 z-20 mt-1.5 w-44 overflow-hidden rounded-lg border-line bg-surface p-1 shadow-pop"
                >
                  {
                    t.status !== 'published' ? (
                      <form method="POST" action={`/api/testimonials/publish?id=${t.id}&back=${back}`}>
                        <button class="block w-full rounded px-2.5 py-2 text-left text-[13px] hover:bg-surface-hover">
                          Publish
                        </button>
                      </form>
                    ) : (
                      <form method="POST" action={`/api/testimonials/hide?id=${t.id}&back=${back}`}>
                        <button class="block w-full rounded px-2.5 py-2 text-left text-[13px] hover:bg-surface-hover">
                          Hide
                        </button>
                      </form>
                    )
                  }
                  <form method="POST" action={`/api/testimonials/favorite?id=${t.id}&back=${back}`}>
                    <button class="block w-full rounded px-2.5 py-2 text-left text-[13px] hover:bg-surface-hover">
                      {t.is_favorite ? 'Remove favorite' : 'Add to favorites'}
                    </button>
                  </form>
                  <form
                    method="POST"
                    action={`/api/testimonials/delete?id=${t.id}&back=${back}`}
                    onsubmit="return confirm('Delete this testimonial permanently?')"
                  >
                    <button class="block w-full rounded px-2.5 py-2 text-left text-[13px] text-danger hover:bg-danger-soft">
                      Delete permanently
                    </button>
                  </form>
                </div>
              </details>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</AppLayout>