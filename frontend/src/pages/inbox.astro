---
import BaseLayout from '../layouts/BaseLayout.astro';
const cookie = Astro.request.headers.get('cookie') ?? '';
const ODOO = process.env.ODOO_URL ?? 'http://localhost:8069';
const status = Astro.url.searchParams.get('status') || 'all';
const space_id = Astro.url.searchParams.get('space_id') || '';
let user = null; let testimonials: any[] = []; let spaces: any[] = []; let error = '';
try {
  const me = await fetch(`${ODOO}/api/auth/me`, { headers: { Cookie: cookie } });
  const mj = await me.json();
  if (!me.ok) return Astro.redirect('/login');
  user = mj.data.user;
  const q = new URLSearchParams();
  if (status !== 'all') q.set('status', status);
  if (space_id) q.set('space_id', space_id);
  const r = await fetch(`${ODOO}/api/testimonials?${q}`, { headers: { Cookie: cookie } });
  const j = await r.json();
  if (r.ok) { testimonials = j.data.testimonials; spaces = j.data.spaces; }
  else error = j.error || 'Could not load inbox.';
} catch { error = 'Backend unreachable.'; }
const tabs = ['all','pending','published','hidden','favorites'];
function tabHref(t: string) {
  const q = new URLSearchParams(); if (t !== 'all') q.set('status', t); if (space_id) q.set('space_id', space_id);
  return '/inbox?' + q.toString();
}
---
<BaseLayout title="Inbox" user={user}>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold">Inbox</h1>
    <form method="GET" action="/inbox">
      <input type="hidden" name="status" value={status} />
      <select name="space_id" onchange="this.form.submit()" class="rounded border px-2 py-1 text-sm">
        <option value="">All spaces</option>
        {spaces.map((s) => <option value={s.id} selected={String(s.id) === space_id}>{s.name}</option>)}
      </select>
    </form>
  </div>
  <div class="mt-3 flex gap-2 text-sm">
    {tabs.map((t) => <a href={tabHref(t)} class={`rounded px-3 py-1 ${status === t ? 'bg-black text-white' : 'border bg-white'}`}>{t[0].toUpperCase() + t.slice(1)}</a>)}
  </div>
  {error && <p class="mt-3 rounded bg-red-50 p-2 text-sm text-red-700">{error}</p>}
  {testimonials.length === 0 && !error ? (
    <div class="mt-6 rounded border bg-white p-8 text-center text-sm text-gray-600">No testimonials here yet. Share your space link to collect some.</div>
  ) : (
    <div class="mt-4 space-y-3">
      {testimonials.map((t) => (
        <div class="rounded border bg-white p-4">
          <div class="flex items-start justify-between gap-2">
            <div class="flex items-center gap-2">
              {t.profile_photo ? <img src={t.profile_photo} class="h-8 w-8 rounded-full object-cover" /> : <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-200 font-bold">{t.name[0]}</div>}
              <div>
                <div class="font-medium">{t.name} <span class="text-xs text-gray-500">{t.company_name && `· ${t.company_name}`} {t.job_title && `(${t.job_title})`}</span></div>
                <div class="text-xs text-gray-500">{t.space_name} · {t.submitted_at?.slice(0,10)} · {t.status}{t.rating ? ` · ⭐${t.rating}` : ''}</div>
              </div>
            </div>
            <form method="POST" action={`/api/testimonials/favorite?id=${t.id}&back=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}>
              <button title="Favorite" class={`text-xl ${t.is_favorite ? '' : 'opacity-30'}`}>❤️</button>
            </form>
          </div>
          <p class="mt-2 text-sm">{t.content}</p>
          <div class="mt-2 flex items-center gap-2 text-sm">
            {t.status !== 'published' && <form method="POST" action={`/api/testimonials/publish?id=${t.id}&back=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}><button class="rounded bg-green-600 px-2 py-1 text-white text-xs">Publish</button></form>}
            {t.status === 'published' && <form method="POST" action={`/api/testimonials/hide?id=${t.id}&back=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}><button class="rounded border px-2 py-1 text-xs">Hide</button></form>}
            <details class="relative text-xs">
              <summary class="cursor-pointer rounded border px-2 py-1">•••</summary>
              <div class="absolute right-0 z-10 mt-1 w-28 rounded border bg-white p-1 shadow">
                {t.status !== 'published'
                  ? <form method="POST" action={`/api/testimonials/publish?id=${t.id}&back=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}><button class="block w-full px-2 py-1 text-left hover:bg-gray-100">Publish</button></form>
                  : <form method="POST" action={`/api/testimonials/hide?id=${t.id}&back=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}><button class="block w-full px-2 py-1 text-left hover:bg-gray-100">Hide</button></form>}
                <form method="POST" action={`/api/testimonials/delete?id=${t.id}&back=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`} onsubmit="return confirm('Delete permanently?')"><button class="block w-full px-2 py-1 text-left text-red-600 hover:bg-gray-100">Delete</button></form>
              </div>
            </details>
          </div>
        </div>
      ))}
    </div>
  )}
</BaseLayout>
