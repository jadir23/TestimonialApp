---
/**
 * Shell for unauthenticated pages (landing, login, register, password reset).
 * Centred card on a subtle gradient, with the theme toggle available.
 */
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const { title = 'Testimonial', description = '', wide = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline src="/theme.js"></script>
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-brand focus:px-3 focus:py-2 focus:text-sm focus:text-brand-fg"
      >Skip to content</a
    >

    <button
      type="button"
      data-theme-toggle
      class="btn btn-secondary btn-icon fixed top-4 right-4 z-40"
      aria-label="Toggle dark mode"
    >
      <svg
        class="size-4 dark:hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
        ><path
          d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-14v2m0 18v-2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"
        /></svg
      >
      <svg
        class="hidden size-4 dark:block"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg
      >
    </button>

    <main
      id="main"
      class:list={['mx-auto flex min-h-screen flex-col px-4 py-10 sm:py-14', wide ? 'max-w-6xl' : 'max-w-md justify-center']}
    >
      <slot />
    </main>

    <script>
      document.addEventListener('click', (e) => {
        const t = (e.target as HTMLElement).closest('[data-theme-toggle]');
        if (!t) return;
        const root = document.documentElement;
        const next = root.classList.contains('dark') ? 'light' : 'dark';
        root.classList.toggle('dark', next === 'dark');
        root.style.colorScheme = next;
        try {
          localStorage.setItem('ts-theme', next);
        } catch {}
      });
    </script>
  </body>
</html>