---
interface Props { title?: string; user?: { name: string; plan: string } | null }
const { title = 'Testimonial SaaS', user = null } = Astro.props;
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body class="min-h-screen bg-gray-50 text-gray-900">
  <header class="border-b bg-white">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
      <a href="/dashboard" class="font-bold">⭐ Testimonial SaaS</a>
      <nav class="flex items-center gap-3 text-sm">
        {user ? (
          <>
            <a href="/spaces" class="underline">Spaces</a>
            <a href="/inbox" class="underline">Inbox</a>
            <a href="/embeds" class="underline">Embeds</a>
            <span class="rounded bg-gray-100 px-2 py-1">{user.plan}</span>
            <span>{user.name}</span>
            <form method="POST" action="/api/logout"><button class="underline">Logout</button></form>
          </>
        ) : (
          <>
            <a href="/login" class="underline">Login</a>
            <a href="/register" class="rounded bg-black px-3 py-1.5 text-white">Sign up</a>
          </>
        )}
      </nav>
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-4 py-8"><slot /></main>
</body>
</html>
