---
/** Consistent page title block: heading, optional description, right-side actions. */
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}
const { title, description, eyebrow } = Astro.props;
---

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-0">
    {eyebrow && <p class="mb-1 text-xs font-semibold tracking-wide text-brand uppercase">{eyebrow}</p>}
    <h1 class="text-2xl font-semibold tracking-tight sm:text-[26px]">{title}</h1>
    {description && <p class="mt-1 text-sm text-fg-muted">{description}</p>}
  </div>
  {
    Astro.slots.has('actions') && (
      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <slot name="actions" />
      </div>
    )
  }
</div>