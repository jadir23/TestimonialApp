# VPS deploy — put behind Caddy/Nginx for TLS.
# Odoo internal URL (frontend -> odoo via docker network)
ODOO_URL=http://odoo:8069
# Public URL of the app (used in share links)
PUBLIC_APP_URL=https://app.example.com
# Postgres
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-in-production
# Odoo master password (for db manager, disable in prod if unused)
ODOO_ADMIN_PASSWD=change-me-too
# Stripe (Phase 6) — get from https://dashboard.stripe.com
# Server-only keys: NEVER expose these to the browser.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe CLI local test: stripe listen --forward-to localhost:8069/api/stripe/webhook
